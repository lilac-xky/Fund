# SMTP 密钥模板
# 复制到同目录的 secrets.env 后填入真实值；secrets.env 已被 .gitignore 排除，
# 接口与日志都不会回显这里的任何值，application.yml 里也不再出现账号与收件人。
# 这个模板只说明键名与格式，不要在这里写真实口令。

# SMTP 主机，foxmail / QQ 邮箱为 smtp.qq.com
SMTP_HOST=smtp.qq.com
# SMTP 端口，587 走 STARTTLS、465 走 SSL
SMTP_PORT=587
# SMTP 账号与发件地址
SMTP_USERNAME=
# 收件地址，多个用逗号分隔；发件与收件是同一个邮箱时填同一个
SMTP_RECIPIENTS=
# SMTP 授权码（不是登录密码），在邮箱设置里开启 SMTP 后获取
SMTP_PASSWORD=

# 应用登录口令，单层登录即全部防线，务必填足够长的随机串
# 接口与日志都不会回显，登录失败次数超限会临时锁定
AUTH_USERNAME=
AUTH_PASSWORD=
